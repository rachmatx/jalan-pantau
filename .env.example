# Contoh konfigurasi JalanPantau. Salin ke .env lalu isi nilainya.
# Semua dibaca dari environment (os.environ) — lihat web/app.py & web/database.py.
# Jangan commit berkas .env yang berisi nilai asli.

# WAJIB untuk produksi/demo: kunci sesi tetap.
# Bila kosong, server memakai secret acak -> semua sesi login hangus setiap restart.
JP_SECRET_KEY=ganti-dengan-string-acak-panjang

# Sandi akun admin demo. Bila kosong, memakai default "jalanpantau2026"
# (server akan mencetak peringatan saat memakai default).
JP_DEMO_PASS=

# Umur sesi login dalam jam (default 12).
JP_SESSION_HOURS=12

# Set "1" bila aplikasi di balik HTTPS agar cookie sesi Secure.
JP_HTTPS=0

# Set "0" untuk mematikan proteksi CSRF (hanya untuk debugging; default aktif).
JP_CSRF=1

# Mode debug Flask (jangan diaktifkan di produksi; default 0).
JP_DEBUG=0
