# Salin berkas ini menjadi ".env" di folder yang sama (deploy/oracle/.env),
# lalu isi nilainya. JANGAN commit .env yang sudah terisi.

# WAJIB: kunci sesi tetap. Hasilkan dengan: openssl rand -hex 32
# Bila kosong, server memakai secret acak -> semua sesi login hangus
# setiap container restart.
JP_SECRET_KEY=

# WAJIB DIGANTI sebelum aplikasi terekspos internet: sandi akun admin.
# Bila kosong, default-nya "jalanpantau2026" dan server mencetak
# peringatan. Pakai sandi kuat yang berbeda dari sandi lain milikmu.
JP_DEMO_PASS=

# Umur sesi login (jam). Keputusan produk aplikasi ini: 8 jam tetap.
JP_SESSION_HOURS=8

# "1" HANYA bila situs sudah disajikan lewat HTTPS (mode domain di
# Caddyfile). Bila masih akses HTTP via IP, biarkan "0" — nilai "1" di
# HTTP membuat cookie sesi tidak terkirim dan login gagal terus.
JP_HTTPS=0

# Proteksi CSRF: biarkan aktif.
JP_CSRF=1

# Debug Flask: jangan pernah "1" di server publik.
JP_DEBUG=0
